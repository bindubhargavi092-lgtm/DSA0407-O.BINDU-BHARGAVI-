
import numpy as np

student_scores = np.array([
    [80, 75, 90, 85],
    [70, 85, 80, 75],
    [90, 95, 85, 80],
    [60, 70, 75, 90]
])

subjects = ["Math", "Science", "English", "History"]

averages = np.mean(student_scores, axis=0)

print("Average marks of each subject:")
for i in range(4):
    print(subjects[i], ":", averages[i])

highest = np.argmax(averages)
print("Highest average subject:", subjects[highest])
print("Highest average marks:", np.max(averages))
